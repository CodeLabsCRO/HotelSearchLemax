@model HotelSearchLemax.Core.Entities.Hotel

@{
    ViewData["Title"] = "Delete Hotel";
}

<h1>Delete Hotel</h1>
<hr />

<div class="alert alert-danger">
    <h4 class="alert-heading">Are you sure you want to delete this hotel?</h4>
    <p>This action cannot be undone.</p>
</div>

<div class="card" style="max-width: 500px;">
    <div class="card-header">
        <h4 class="mb-0">@Model.Name</h4>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Price)</dt>
            <dd class="col-sm-8">€@Model.Price.ToString("F2")</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Latitude)</dt>
            <dd class="col-sm-8">@Model.Latitude.ToString("F6")</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Longitude)</dt>
            <dd class="col-sm-8">@Model.Longitude.ToString("F6")</dd>
        </dl>
    </div>
    <div class="card-footer">
        <form asp-action="Delete" style="display: inline;">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Yes, Delete</button>
        </form>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</div>
